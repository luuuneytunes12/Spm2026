# Supabase Postgres connection string.
# In Supabase: Project Settings -> Database -> Connection string -> URI
# (use the "Session pooler" or "Transaction pooler" URI for serverless/edge
# deployments; the direct connection URI is fine for local dev / a
# long-lived server). Rewrite the scheme to postgresql+psycopg:// and
# URL-encode any special characters in the password.
DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@[PROJECT-REF].supabase.co:5432/postgres

# Optional, not used by the current direct-Postgres setup. Only needed
# if you later add supabase-py for Auth/Storage/Realtime, or verify
# Supabase Auth JWTs server-side. Project Settings -> API.
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://[PROJECT-REF].supabase.co/auth/v1/.well-known/jwks.json

# Comma-separated list of origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173

# JWT auth settings. JWT_SECRET must be a long random string (e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(48))"`); keep it
# out of version control. Rotating it invalidates all outstanding
# access/refresh tokens.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7
